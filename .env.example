# 값은 Vercel 프로젝트 Settings → Environment Variables에 넣고, 여기엔 이름만 남겨두세요.

# 네이버 클라우드 플랫폼(NCP) → Maps → Application의 Client ID (지도 표시용, 공개 키)
NAVER_MAP_CLIENT_ID=
# (선택) NCP Maps → Style Editor에서 발행한 My Style ID. 넣으면 지도 바탕을 캐치캐치 스타일로 바꿔요
NAVER_MAP_STYLE_ID=

# Naver Developers → 애플리케이션 등록 → 검색 API (가챠샵 검색용, 무료)
NAVER_SEARCH_ID=
NAVER_SEARCH_SECRET=

# OpenAI API 키 (platform.openai.com → API keys). 사진 분석용, 충전한 금액에서 사용한 만큼 차감돼요.
# 비워두면 사진 분석이 꺼져요
OPENAI_API_KEY=
