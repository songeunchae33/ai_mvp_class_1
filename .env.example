# 값은 Vercel 프로젝트 Settings → Environment Variables에 넣고, 여기엔 이름만 남겨두세요.
# 키가 없는 항목은 화면에 '예시 데이터'로 표시돼요. 전부 무료예요 (OPENAI만 충전 금액에서 차감).

# 공공데이터포털(data.go.kr) 일반 인증키 (Decoding). 아래 두 API를 각각 '활용신청'해야 해요
#  - 금융위원회_주식시세정보, 금융위원회_지수시세정보  → 관심 종목·코스피·코스닥 (전일 종가)
#  - 행정안전부_대한민국 공공서비스(혜택) 정보         → 우리 지역 혜택 (지자체·교육청·정부)
#  - 문화체육관광부_정책브리핑_보도자료               → 쉽게 풀이(AI), 경제 공부 화제순
DATA_GO_KR_KEY=

# 한국수출입은행 Open API 인증키 (koreaexim.go.kr → 오픈API → 환율) → 원/달러 환율
KOREAEXIM_KEY=

# 네이버 뉴스 검색 (뉴스 목록: 제목+링크 그대로 보여주기용. 약관상 AI 요약에는 쓰지 않음)
# 새 방식: 네이버 클라우드 플랫폼 → NAVER API HUB → Application 등록(검색) → 인증 정보
#   지금은 한시적 무료, 나중에 사용한 만큼 유료 전환 예정 → 콘솔에서 일/월 이용 한도를 꼭 설정
NAVER_HUB_ID=
NAVER_HUB_SECRET=
# (예전 방식) 네이버 개발자센터 검색 API 키가 이미 있다면 여기에. 2027-06-30까지 사용 가능
NAVER_SEARCH_ID=
NAVER_SEARCH_SECRET=

# (선택) 금융감독원 금융상품 한눈에(finlife.fss.or.kr) → 오픈API 인증키 → 예금 금리 TOP 3
FINLIFE_KEY=

# OpenAI API 키 → 하단 질문창 답변. 비워두면 질문 기능만 꺼져요
OPENAI_API_KEY=
